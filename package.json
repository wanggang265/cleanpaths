{
  "name": "cleanpaths",
  "version": "0.1.0",
  "private": true,
  "description": "cleanpaths.io — cut-ready DXF/SVG converters running 100% in the browser (Next.js static export → Cloudflare Pages)",
  "scripts": {
    "dev": "next dev",
    "extract": "node scripts/extract-pages.mjs",
    "audit:design": "python3 design-source/build/audit.py",
    "audit:copy": "node scripts/audit-copy.mjs",
    "gate": "bash scripts/deploy-gate.sh",
    "build": "npm run gate && npm run build:flatten && next build && node scripts/postbuild.mjs",
    "build:vendor": "esbuild .vendor-src/vectorizer.js --bundle --format=esm --platform=browser --target=es2022 --external:./worker.js --outfile=public/vendor/vectorizer/vectorizer.bundle.js",
    "build:flatten": "esbuild src/workers/flatten-worker.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=public/vendor/flatten/flatten-worker.js",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "^1.2.4",
    "@neplex/vectorizer": "0.1.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svg-path-properties": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "5.6.3"
  }
}
